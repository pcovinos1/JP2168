  "about": {
    "eyebrow": "Morada",
    "title": "No hay lugar como tu morada",
    "subtitle": "Alta arquitectura peruana",
    "coverImageSrc": "content/restored-media/a5deeb8e2aa8bcd13c1a.png",
    "slides": [
      {
        "id": "about-01",
        "number": "01",
        "text": "Nacimos en el 2013 como una inmobiliaria boutique, comprometida con ofrecer el más alto estándar de arquitectura y servicio del sector inmobiliario en Lima.",
        "keywords": [
          "inmobiliaria boutique",
          "el más alto estándar de arquitectura y servicio del sector inmobiliario"
        ],
        "imageSrc": "content/restored-media/c36165af104bfa24703f.jpg"
      },
      {
        "id": "about-02",
        "number": "02",
        "text": "Trabajamos con talentosísimos arquitectos, artistas, paisajistas, diseñadores y artesanos.\n\nPublicamos David Mutal Arquitecto, creamos pop-ups de fotografía y Morada Home, renovamos espacios públicos y fuimos reconocidos con dos premios nacionales de arquitectura.",
        "keywords": [
          "talentosísimos",
          "renovado",
          "pintado",
          "sembrado",
          "dos premios"
        ],
        "imageSrc": "content/restored-media/69fb568f30a40ff6a07a.jpg"
      },
      {
        "id": "about-03",
        "number": "03",
        "text": "El Perú, su gente, su historia, su legado y su arquitectura son nuestra continua fuente de inspiración.",
        "keywords": [
          "arquitectura son nuestra continua fuente de inspiración"
        ],
        "imageSrc": "content/restored-media/7d2a96a79437fb5c2b2e.jpg"
      }
    ],
